               <rdf:li>B65H 03/06</rdf:li>
               <rdf:li>Device for feeding single sheets out of a stack of film sheets</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Device for feeding single sheets out of a stack of film sheets - European Patent Office - EP 0521459 A1</rdf:li>
               <rdf:li xml:lang="en">Device for feeding single sheets out of a stack of film sheets - European Patent Office - EP 0521459 A1</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
