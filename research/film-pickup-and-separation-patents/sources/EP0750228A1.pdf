      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>EP-0750228-A1-19961227</dc:identifier>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A photographic printing apparatus (1) includes a sorting apparatus (ST) comprising a plurality of receptacles (FR,PR) for receiving negative films (2) and prints which circulate in a closed loop of path between a film loading station (C) in close proximity to an exposure apparatus (EX) and a print loading station where prints cut from a continuous web of photographic paper are delivered, the receptacles (FR,PR) being driven such that each receptacle related to a receptacle loaded with a specific negative film at the film loading station is positioned in the print loading station timely before a cluster (3A) of prints made from the specific negative film is delivered from the photographic printing apparatus. [image]</rdf:li>
               <rdf:li xml:lang="en">A photographic printing apparatus (1) includes a sorting apparatus (ST) comprising a plurality of receptacles (FR,PR) for receiving negative films (2) and prints which circulate in a closed loop of path between a film loading station (C) in close proximity to an exposure apparatus (EX) and a print loading station where prints cut from a continuous web of photographic paper are delivered, the receptacles (FR,PR) being driven such that each receptacle related to a receptacle loaded with a specific negative film at the film loading station is positioned in the print loading station timely before a cluster (3A) of prints made from the specific negative film is delivered from the photographic printing apparatus. [image]</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:language>
            <rdf:Bag>
               <rdf:li>en</rdf:li>
            </rdf:Bag>
         </dc:language>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>European Patent Office</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>EP0750228</rdf:li>
               <rdf:li>EP 0750228</rdf:li>
               <rdf:li>G03D 15/00</rdf:li>
               <rdf:li>Photographic printing apparatus</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Photographic printing apparatus - European Patent Office - EP 0750228 A1</rdf:li>
               <rdf:li xml:lang="en">Photographic printing apparatus - European Patent Office - EP 0750228 A1</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:type>
            <rdf:Bag>
               <rdf:li>EUROPEAN PATENT APPLICATION</rdf:li>
            </rdf:Bag>
         </dc:type>
      </rdf:Description>
