               <rdf:li>G03B 27/62</rdf:li>
               <rdf:li>Film clamp for flattening image frames in a scanning gate</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Film clamp for flattening image frames in a scanning gate - European Patent Office - EP 0660170 A1</rdf:li>
               <rdf:li xml:lang="en">Film clamp for flattening image frames in a scanning gate - European Patent Office - EP 0660170 A1</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
