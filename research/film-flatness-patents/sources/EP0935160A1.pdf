         <patent:Title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Fotoelektrische Abtastvorrichtung und damit ausgestattetes fotografisches KopiergerÃ¤t</rdf:li>
               <rdf:li xml:lang="de">Fotoelektrische Abtastvorrichtung und damit ausgestattetes fotografisches KopiergerÃ¤t</rdf:li>
               <rdf:li xml:lang="en">Photoelectric scanning device and photographic printing apparatus incorporating it</rdf:li>
               <rdf:li xml:lang="fr">Dispositif de balayage photoÃ©lectrique et tireuse photographique comportant un tel dispositif</rdf:li>
            </rdf:Alt>
